# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Containerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Kubernetes generated files — skip generated files, except vendored ones
!vendor/**/zz_generated.*

# OLM bundle artifacts generated by `make bundle`
bundle/
bundle.Dockerfile

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store

# Claude Code state. Session notes, local settings and scratch files live here;
# none of it belongs in the repository, and on some machines only a global
# gitignore was keeping it out.
.claude/

# Things that must never be committed, whatever directory they land in.
*.kubeconfig
kubeconfig
kubeconfig.*
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*
*.env
auth.json
.dockerconfigjson
config.json.bak

# Local deployment overlays: private registries, pull-secret names, cluster
# hostnames, local CI. Everything under config/overlays/ is ignored except the
# README and the example, so a lab's details never reach a commit.
config/overlays/*
!config/overlays/README.md
!config/overlays/example/
