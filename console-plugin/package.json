{
  "name": "chronos-console-plugin",
  "version": "0.0.1",
  "description": "OpenShift console dynamic plugin for Chronos — the change timeline.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/v1k0d3n/chronos.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve --progress",
    "start-console": "./start-console.sh",
    "lint": "yarn eslint src --fix --max-warnings 0",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "4.22-latest",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22-latest",
    "@patternfly/react-core": "^6.4.3",
    "@patternfly/react-icons": "^6.4.0",
    "@patternfly/react-table": "^6.4.3",
    "@swc/core": "^1.15.40",
    "@types/diff": "^5.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "diff": "^4.0.4",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "~16.5.8",
    "react-router": "~7.13.1",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4"
  },
  "consolePlugin": {
    "name": "chronos",
    "version": "0.0.1",
    "displayName": "Chronos",
    "description": "Time machine for OpenShift — a change timeline with diffs and revert.",
    "exposedModules": {
      "ChronosTimelinePage": "./components/ChronosTimelinePage"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.22.0-0"
    }
  },
  "packageManager": "yarn@4.14.1"
}
